{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas anatomiczny 3D",
  "version": "0.1.0",
  "identifier": "com.grypajj.atlas3d",
  "build": {
    "frontendDist": "../../web",
    "beforeDevCommand": "node ../fetch-assets.mjs && node ../assemble.mjs",
    "beforeBuildCommand": "node ../fetch-assets.mjs && node ../assemble.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Atlas anatomiczny 3D",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: ipc: http://ipc.localhost; worker-src 'self' blob:; child-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Polish", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://REPLACE-ME.r2.dev/atlas/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3MUM1RDE4RTAzQTZEQkUKUldTK2JUcmdHRjBjZC9OeFZIdjV3bm8xUDQ2Z2pFVVc5c1cvSjBRUEdTS2s2eUtGS0hDYlRSNHIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
